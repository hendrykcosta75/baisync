DATABASE_URL=127.0.0.1:9042
JWT_SECRET=your-jwt-secret-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
BAILEYS_URL=http://baileys:3025
BAILEYS_API_KEY=your-baileys-api-key
ALLOWED_ORIGINS=http://localhost:3000
BAISYNC_API_KEY=your-gemini-api-key-for-baisync
BAISYNC_RATE_LIMIT_PER_HOUR=150

# Timeout global em segundos para HTTP POST a providers LLM (openai, claude, gemini).
# Não afeta loop de tool execution.
LLM_GLOBAL_TIMEOUT_SECS=60

# ─── T2.3 — Auto-compaction (opt-in por assistente) ─────────────────────────
# Quando um assistant tem `config_auto_compact=true` e uma conversa ultrapassa
# o threshold configurado, o backend resume mensagens antigas via um LLM barato
# pago pela plataforma (esta key) — NUNCA a key do usuário. Deixar
# COMPACTION_API_KEY vazio desativa o recurso globalmente (emite WARN).
COMPACTION_API_KEY=
COMPACTION_MODEL=gpt-4o-mini
COMPACTION_PROVIDER=openai
COMPACTION_THRESHOLD_PCT=0.80
COMPACTION_MIN_MESSAGES=15
COMPACTION_KEEP_RECENT=5
COMPACTION_RATE_LIMIT_SECS=3600
