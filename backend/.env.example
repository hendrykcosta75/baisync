DATABASE_URL=127.0.0.1:9042
JWT_SECRET=your-jwt-secret-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ─── T3.2 F1 — Encryption key versioning (workspace_api_keys only) ─────────
# When any ENCRYPTION_KEY_Vn is set, it takes precedence over ENCRYPTION_KEY.
# The highest Vn loaded is `current_version` (used for NEW encryption); all
# loaded versions remain available for decrypt so old ciphertext still reads.
#
# Rotation: add V2 alongside V1, redeploy, let rows re-encrypt naturally
# on user edits; remove V1 only after all workspace_api_keys rows have
# key_version=2. Scope is workspace_api_keys only — other encrypted tables
# (assistant_integrations, users.* legacy) still use the single-key path.
ENCRYPTION_KEY_V1=
***REMOVED***
ENCRYPTION_KEY_V3=
BAILEYS_URL=http://baileys:3025
BAILEYS_API_KEY=your-baileys-api-key
ALLOWED_ORIGINS=http://localhost:3000
BAISYNC_API_KEY=your-gemini-api-key-for-baisync
BAISYNC_RATE_LIMIT_PER_HOUR=150

# Timeout global em segundos para HTTP POST a providers LLM (openai, claude, gemini).
# Não afeta loop de tool execution.
LLM_GLOBAL_TIMEOUT_SECS=60

# ─── T2.3 — Auto-compaction (opt-in por assistente) ─────────────────────────
# Quando um assistant tem `config_auto_compact=true` e uma conversa ultrapassa
# o threshold configurado, o backend resume mensagens antigas via um LLM barato
# pago pela plataforma (esta key) — NUNCA a key do usuário. Deixar
# COMPACTION_API_KEY vazio desativa o recurso globalmente (emite WARN).
COMPACTION_API_KEY=
COMPACTION_MODEL=gpt-4o-mini
COMPACTION_PROVIDER=openai
COMPACTION_THRESHOLD_PCT=0.80
COMPACTION_MIN_MESSAGES=15
COMPACTION_KEEP_RECENT=5
COMPACTION_RATE_LIMIT_SECS=3600

# ─── W2.1 — Post-turn evaluator (opt-in por assistente) ────────────────────
# Quando um assistant tem `config_enable_evaluator=true`, o backend dispara
# (fire-and-forget, após a resposta já ter sido enviada ao usuário) uma
# revisão por um LLM barato da plataforma para detectar: vazamento de PII,
# promessas impossíveis e contradições ao system prompt. Usa SEMPRE esta key
# (ou, se vazia, faz fallback para COMPACTION_API_KEY). NUNCA usa a key do
# usuário. Deixar ambas vazias desativa o recurso globalmente (emite WARN).
EVALUATOR_API_KEY=
EVALUATOR_PROVIDER=openai
EVALUATOR_MODEL=gpt-4o-mini
# Cap de evaluators concorrentes (semaphore). Evaluators que chegarem acima
# deste limite são DESCARTADOS (log WARN) — nunca enfileirados.
EVALUATOR_MAX_CONCURRENT=20
# Timeout hard do LLM do evaluator em segundos. Menor que o timeout primary
# de propósito — evaluator deve ser rápido ou desistir.
EVALUATOR_TIMEOUT_SECS=15
