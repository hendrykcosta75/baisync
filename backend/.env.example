DATABASE_URL=127.0.0.1:9042
JWT_SECRET=your-jwt-secret-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
BAILEYS_URL=http://baileys:3025
BAILEYS_API_KEY=your-baileys-api-key
ALLOWED_ORIGINS=http://localhost:3000
BAISYNC_API_KEY=your-gemini-api-key-for-baisync
BAISYNC_RATE_LIMIT_PER_HOUR=150

# Timeout global em segundos para HTTP POST a providers LLM (openai, claude, gemini).
# Não afeta loop de tool execution.
LLM_GLOBAL_TIMEOUT_SECS=60
