# ===========================================
# Inertial Eclipse - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=inertial_eclipse

# Backend server
DATABASE_URL=cassandra:9042

# JWT
JWT_SECRET=your-secret-key-change-in-production

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@inertial-eclipse.com

# Encryption (32 bytes hex for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis
REDIS_PASSWORD=

# Messaging containers
BAILEYS_URL=http://baileys:3025
BAILEYS_API_KEY=your-baileys-api-key
# Baisync Agent (Gemini 3 Flash powered dashboard assistant)
BAISYNC_API_KEY=your-gemini-api-key-for-baisync
BAISYNC_RATE_LIMIT_PER_HOUR=150

# Meta WhatsApp Cloud API (optional — required if using Meta official webhook)
META_APP_SECRET=

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production

# LiveKit (video meetings SFU)
# Use browser-reachable URL — backend passes this through to the frontend.
# Backend never makes HTTP calls to LiveKit; it only signs tokens, so internal Docker URL isn't needed.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_chars_xxxxxx
# Optional: override LIVEKIT_URL only for the frontend (takes precedence if set at build time)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
