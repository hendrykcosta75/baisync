# ===========================================
# Inertial Eclipse - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=inertial_eclipse

# Backend server
DATABASE_URL=cassandra:9042

# JWT
JWT_SECRET=your-secret-key-change-in-production

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@inertial-eclipse.com

# Encryption (32 bytes hex for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── T3.2 F1 — Encryption key versioning (workspace_api_keys only) ─────────
# When set, these take precedence over ENCRYPTION_KEY. Each must be 64 hex
# chars (32 bytes). The highest Vn present is used for NEW encryption
# (`current_version`); all loaded versions are available for decrypt so
# ciphertext written under any prior version remains readable.
#
# Online rotation flow:
#   1. Generate a new key: `openssl rand -hex 32`
#   2. Add it as ENCRYPTION_KEY_V2 alongside the existing ENCRYPTION_KEY_V1
#      (or alongside the legacy ENCRYPTION_KEY which is treated as V1).
#   3. Redeploy. New writes and re-writes use V2; old rows keep working.
#   4. Optional: after all workspace_api_keys rows have key_version=2,
#      remove ENCRYPTION_KEY_V1 and redeploy.
#
# Scope: ONLY workspace_api_keys opts in (migration 101). Other encrypted
# tables (assistant_integrations, users.* legacy) still use the single
# ENCRYPTION_KEY semantics; rotating those is S0b / offline re-encrypt.
ENCRYPTION_KEY_V1=
***REMOVED***
ENCRYPTION_KEY_V3=

# Redis
REDIS_PASSWORD=

# Messaging containers
BAILEYS_URL=http://baileys:3025
BAILEYS_API_KEY=your-baileys-api-key
# CORS allowlist — comma-separated list of origins allowed to call the backend API.
# Defaults to APP_URL if unset. Example: http://localhost:3000,https://staging.example.com
ALLOWED_ORIGINS=http://localhost:3000
# Baisync Agent (Gemini 3 Flash powered dashboard assistant)
BAISYNC_API_KEY=your-gemini-api-key-for-baisync
BAISYNC_RATE_LIMIT_PER_HOUR=150

# Timeout global em segundos para HTTP POST a providers LLM (openai, claude, gemini).
# Não afeta loop de tool execution.
LLM_GLOBAL_TIMEOUT_SECS=60

# ─── T2.3 — Auto-compaction (opt-in por assistente) ─────────────────────────
# Quando um assistant tem `config_auto_compact=true` e uma conversa ultrapassa
# o threshold configurado, o backend resume as mensagens antigas via um LLM
# barato financiado pela plataforma (esta key) — NUNCA a key do usuário.
# Deixar COMPACTION_API_KEY vazio desativa o recurso globalmente (um WARN
# é emitido no startup). Todas as outras variáveis são opcionais.
COMPACTION_API_KEY=
COMPACTION_MODEL=gpt-4o-mini
COMPACTION_PROVIDER=openai
# Threshold fracionário: dispara quando total_tokens/max_tokens >= este valor.
COMPACTION_THRESHOLD_PCT=0.80
# Minimum de mensagens antes de sequer considerar compactar.
COMPACTION_MIN_MESSAGES=15
# Quantas mensagens mais recentes preservar sem compactar.
COMPACTION_KEEP_RECENT=5
# Rate limit por (user_id, conversation_id). Alinha com TTL da migration 098
# (compaction_rate_limits). Mudar este valor NÃO atualiza o TTL da tabela.
COMPACTION_RATE_LIMIT_SECS=3600

# ─── W2.1 — Post-turn evaluator (opt-in por assistente) ────────────────────
# Quando um assistant tem `config_enable_evaluator=true`, o backend dispara
# (fire-and-forget, após a resposta já ter sido enviada ao usuário) uma
# revisão por um LLM barato da plataforma para detectar: vazamento de PII,
# promessas impossíveis e contradições ao system prompt. Usa SEMPRE esta key
# (ou, se vazia, faz fallback para COMPACTION_API_KEY). NUNCA usa a key do
# usuário. Deixar ambas vazias desativa o recurso globalmente (emite WARN).
EVALUATOR_API_KEY=
EVALUATOR_PROVIDER=openai
EVALUATOR_MODEL=gpt-4o-mini
# Cap de evaluators concorrentes (semaphore). Evaluators que chegarem acima
# deste limite são DESCARTADOS (log WARN) — nunca enfileirados (backlogs
# drenariam latência e o usuário já recebeu a resposta).
EVALUATOR_MAX_CONCURRENT=20
# Timeout hard do LLM do evaluator em segundos. Menor que o timeout primary
# de propósito — evaluator deve ser rápido ou desistir.
EVALUATOR_TIMEOUT_SECS=15

# Meta WhatsApp Cloud API (optional — required if using Meta official webhook)
META_APP_SECRET=

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production

# LiveKit (video meetings SFU)
# Use browser-reachable URL — backend passes this through to the frontend.
# Backend never makes HTTP calls to LiveKit; it only signs tokens, so internal Docker URL isn't needed.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_chars_xxxxxx
# Optional: override LIVEKIT_URL only for the frontend (takes precedence if set at build time)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
